#!/usr/bin/env bash
set -euo pipefail
# Follow symlinks (e.g. ~/.local/bin/standardnotes-mcp) to the checkout; relative links resolve from their directory.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" == /* ]] || SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
if [[ "${1:-}" == help || "${1:-}" == --help ]]; then
    printf '%s\n' 'Usage: standardnotes-mcp [serve|login|logout|approve OPERATION_UUID|unlock --clients-stopped]' \
      'Credentials: interactive login stores them only in your OS keychain.' \
      'State: set SN_STATE_DIR or DATA_DIR; DATA_DIR is otherwise read (never executed) from a local dotfiles machine file if present.' \
      'Writes: the agent prepares a preview over MCP; you review it here with approve OPERATION_UUID (type the phrase, or "reject"), then the agent commits.'
    exit 0
fi
# Never source machine files: src/config.ts reads DATA_DIR from one as data, else uses the OS state directory.
if [[ -n "${DATA_DIR:-}" ]]; then export DATA_DIR; fi
[[ -f "$ROOT/dist/index.js" && -d "$ROOT/node_modules" ]] || {
    printf '%s\n' 'Connector is not built/installed. See docs/LOCAL-SETUP.md; do not download unpinned packages automatically.' >&2
    exit 1
}
MODE="${1:-serve}"
if [[ $# -gt 0 ]]; then shift; fi
case "$MODE" in
    serve) [[ $# == 0 ]] || exit 2; exec node "$ROOT/dist/index.js" ;;
    login) [[ $# == 0 ]] || exit 2; exec node "$ROOT/dist/cli/login.js" ;;
    logout) [[ $# == 0 ]] || exit 2; exec node "$ROOT/dist/cli/logout.js" ;;
    approve) exec node "$ROOT/dist/cli/approve.js" "$@" ;;
    unlock) exec node "$ROOT/dist/cli/unlock.js" "$@" ;;
    *) printf '%s\n' 'Unknown command; use --help' >&2; exit 2 ;;
esac
