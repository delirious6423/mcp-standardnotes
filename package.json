{
  "name": "standardnotes-safe-mcp",
  "version": "0.7.0",
  "private": true,
  "description": "MCP server for a Standard Notes vault with previewed, terminal-approved, undoable writes (end-to-end encrypted, local stdio only)",
  "license": "MIT",
  "author": "Guillaume Ferrari",
  "contributors": ["delirious6423"],
  "homepage": "https://github.com/delirious6423/mcp-standardnotes#readme",
  "bugs": {
    "url": "https://github.com/delirious6423/mcp-standardnotes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delirious6423/mcp-standardnotes.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "standard-notes",
    "standardnotes",
    "claude",
    "anthropic",
    "e2ee",
    "encryption",
    "notes",
    "argon2id",
    "xchacha20"
  ],
  "type": "module",
  "bin": {
    "mcp-standardnotes": "dist/index.js",
    "mcp-standardnotes-login": "dist/cli/login.js",
    "mcp-standardnotes-logout": "dist/cli/logout.js",
    "mcp-standardnotes-install": "dist/cli/install.js"
  },
  "files": [
    "dist/",
    "docs/",
    "banner@2x.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx src/cli/login.ts",
    "logout": "tsx src/cli/logout.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "audit": "npm audit --audit-level=high",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "keytar": "^7.9.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "hono": "^4.13.13",
    "brace-expansion": "^2.1.7",
    "js-yaml": "^5.5.0",
    "ip-address": "^10.7.4",
    "postcss": "^8.5.31",
    "nanoid": "^3.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.57.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
